---
import EmptyLayout from '../layouts/EmptyLayout.astro';
---
<EmptyLayout title="q3-hashme Utility">

    <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      font-size: 16px;
    }
    h1 {
      font-size: 1.8rem;
      margin-bottom: 1.5rem;
      text-align: center;
    }
    form {
      margin-bottom: 20px;
    }
    .input-group {
      margin-bottom: 15px;
      position: relative;
    }
    input {
      padding: 12px;
      width: 100%;
      border: 1px solid #ccc;
      border-radius: 4px;
      box-sizing: border-box;
      font-size: 16px; /* Prevents zoom on iOS */
    }
    input[type="checkbox"] {
      width: auto;
      padding: 0;
      margin: 0;
      transform: scale(1.2);
    }
    input:focus {
      outline: none;
      border-color: #4a90e2;
      box-shadow: 0 0 0 2px rgba(74, 144, 226, 0.2);
    }
    label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }
    #result,
    #extended-result,
    #hard-result {
      font-weight: bold;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      padding: 12px;
      border: 1px dashed #ccc;
      border-radius: 4px;
      display: block;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      background-color: #f9f9f9;
      transition: background-color 0.2s;
      word-break: break-all;
      margin-top: 5px;
      cursor: pointer;
    }
    #result-index,
    #extended-result-index,
    #hard-result-index {
      margin-top: 8px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 1rem;
      font-weight: bold;
      line-height: 1.2;
      color: #666;
      text-align: center;
      visibility: hidden;
    }
    #result:hover,
    #extended-result:hover,
    #hard-result:hover {
      background-color: #f0f0f0;
    }
    #result:active,
    #extended-result:active,
    #hard-result:active {
      background-color: #e0e0e0;
    }
    #extended-result-container,
    #hard-result-container {
      margin-top: 15px;
      display: none;
    }
    .result-container {
      margin-top: 25px;
    }
    .result-label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }
    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .red {
      color: #e74c3c;
    }
    .note {
      font-size: 0.85em;
      color: #666;
      margin-top: 25px;
      background-color: #f9f9f9;
      padding: 15px;
      border-radius: 4px;
      border-left: 4px solid #4a90e2;
    }
    .note p {
      margin: 0.5em 0;
    }

    /* Media queries for responsive design */
    @media (max-width: 480px) {
      body {
        padding: 15px;
      }
      h1 {
        font-size: 1.5rem;
      }
      input {
        padding: 10px;
      }
      .note {
        padding: 10px;
      }
    }
  </style>


  <!-- Paste the old HTML form structure here -->
  <h1>q3-hashme</h1>

  <form>
    <div class="input-group">
      <label for="pw1">Master Password:</label>
      <input id="pw1" type="password" autocomplete="off" placeholder="Enter your master password" />
    </div>

    <div class="input-group">
      <label for="dom1">Domain:</label>
      <input id="dom1" type="text" placeholder="e.g., example.com" />
    </div>

    <div class="input-group">
      <label for="pw2">Confirm Password:</label>
      <input id="pw2" type="password" autocomplete="off" placeholder="Re-enter your master password" />
    </div>

    <div class="input-group">
      <label for="dom2">Confirm Domain:</label>
      <input id="dom2" type="text" placeholder="Re-enter the domain" />
    </div>
  </form>

  <div class="result-container">
    <div>
      <span class="result-label">Generated Password:</span>
      <div id="result">Enter details above</div>
      <div id="result-index"></div>
    </div>
    <div class="input-group" style="margin-top: 15px;">
      <label for="extension">Extension:</label>
      <input id="extension" type="text" placeholder="Optional, e.g. /b" />
    </div>
    <div id="extended-result-container">
      <span class="result-label">Generated Password (with extension):</span>
      <div id="extended-result"></div>
      <div id="extended-result-index"></div>
    </div>
    <div class="input-group" style="margin-top: 15px;">
      <label for="hard-mode-enabled">Hard mode:</label>
      <div class="checkbox-row">
        <input id="hard-mode-enabled" type="checkbox" />
        <span>Generate additional password with Argon2id</span>
      </div>
    </div>
    <div id="hard-result-container">
      <span class="result-label">Generated Password (hard mode):</span>
      <div id="hard-result"></div>
      <div id="hard-result-index"></div>
    </div>
  </div>

  <div class="note">
    <p>Click on the generated password to copy it to clipboard.</p>
    <p>Note: This tool works entirely in your browser. Your master password is never sent to any server.</p>
  </div>

  <script>
    import '../scripts/hashme-q3-ui.js';
  </script>
</EmptyLayout>
